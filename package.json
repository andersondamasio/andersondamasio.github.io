{
  "name": "anderson-damasio-blog",
  "version": "1.0.0",
  "description": "Perfil e Artigos",
  "main": "gerar-conteudo.js",
  "scripts": {
    "start": "node gerar-conteudo.js",
    "seo:rebuild": "node gerar-conteudo.js --rebuild-seo",
    "seo:normalize-categories": "node scripts/normalize-title-categories.js",
    "seo:backfill": "node scripts/seo-backfill-articles.js",
    "seo:backfill:static": "node scripts/seo-backfill-static.js",
    "seo:audit": "node scripts/seo-audit.js",
    "seo:audit:strict": "node scripts/seo-audit.js --strict",
    "seo:icons": "node scripts/seo-icons.js",
    "seo:maintain": "npm run seo:icons && npm run seo:indexation:check && npm run seo:normalize-categories && npm run seo:backfill && npm run seo:backfill:static && npm run seo:rebuild && npm run seo:audit:strict",
    "seo:indexation:plan": "node scripts/indexation-policy.js",
    "seo:indexation:check": "node scripts/indexation-policy.js --check",
    "test:seo:indexation": "node --test scripts/test-indexation-policy.js scripts/test-seo-consolidation.js",
    "test:humanizer": "node scripts/test-humanizer-editorial.js",
    "test:editorial": "node --test scripts/test-editorial-policy.js scripts/test-editorial-review.js scripts/test-source-comparison.js scripts/test-editorial-transaction.js scripts/test-editorial-preview.js scripts/test-editorial-queue.js",
    "test:seo:templates": "node --test scripts/test-seo-templates.js scripts/test-seo-article-metadata.js scripts/test-seo-icons.js scripts/test-editorial-legacy-curation.js",
    "test:examples": "node --test exemplos/design-tokens/test.js exemplos/metricas-exatas/test.js exemplos/estado-versionado/test.js scripts/test-article-examples.js scripts/test-native-article-examples.js",
    "outreach:prepare": "node scripts/editorial-outreach.js",
    "seo:outcomes": "node scripts/seo-outcome-measurement.js",
    "test:seo:outreach": "node --test scripts/test-editorial-outreach.js scripts/test-seo-outcome-measurement.js",
    "test:seo:navigation": "node --test scripts/test-seo-archive.js scripts/test-seo-navigation-integration.js scripts/test-seo-selected-readings.js",
    "seo:navigation": "node scripts/seo-navigation.js --strict",
    "article:review": "node scripts/editorial-cli.js",
    "article:preview": "node scripts/editorial-preview.js",
    "article:queue": "node scripts/editorial-queue.js",
    "editorial:inventory": "node scripts/editorial-inventory.js",
    "article:draft": "node gerar-conteudo.js --draft-only",
    "seo:urls:plan": "node scripts/stabilize-article-urls.js",
    "seo:urls:apply": "node scripts/stabilize-article-urls.js --apply",
    "seo:verify:deployment": "node scripts/verify-deployment.js",
    "test:seo:recovery": "node --test scripts/test-deployment.js scripts/test-stable-urls.js scripts/test-seo-measurement.js scripts/test-wait-for-pages.js scripts/test-seo-performance-lab.js",
    "seo:performance:lab": "node scripts/seo-performance-lab.js --capture",
    "seo:measurement": "node scripts/seo-measurement.js --capture",
    "test:rebuild:site": "node scripts/test-rebuild-site.js",
    "test:model:budget": "node --test scripts/test-model-evaluation-budget.js scripts/test-model-evaluation.js",
    "model:evaluation:plan": "node scripts/model-evaluation.js"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "glob": "^11.0.2",
    "rss-parser": "^3.13.0",
    "sharp": "^0.33.3",
    "marked": "^12.0.2",
    "cheerio": "^1.0.0-rc.12",
    "puppeteer": "^22.8.2",
    "@mozilla/readability": "^0.4.4",
    "jsdom": "^24.0.0"
  }
}
